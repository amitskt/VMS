{
  "name": "sankalptaru-backend",
  "version": "1.0.0",
  "description": "Auth backend for SankalpTaru VMS \u2014 volunteer email/password + Google SSO, staff (manager/admin) Google-only SSO restricted to the sankalptaru.org domain.",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed:staff": "node seed/seedStaff.js",
    "drive:auth": "node scripts/getGoogleDriveToken.js",
    "migrate:remove-selected": "node scripts/migrateRemoveSelectedStatus.js",
    "seed:certificate-templates": "node scripts/seedCertificateTemplates.js",
    "migrate:pin-certificate-templates": "node scripts/migratePinCertificateTemplates.js",
    "backfill:volunteer-drive-folders": "node scripts/backfillVolunteerDriveFolders.js",
    "refresh:certificate-template-images": "node scripts/refreshCertificateTemplateImages.js",
    "backfill:email-verified": "node scripts/backfillEmailVerified.js",
    "fix:volunteer-drive-folders": "node scripts/fixVolunteerDriveFolders.js"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1123.0",
    "@google/genai": "^2.21.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "google-auth-library": "^9.11.0",
    "googleapis": "^140.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.15.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
