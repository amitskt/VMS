GOOGLE_CLIENT_ID=

MONGO_URI=

JWT_SECRET=
JWT_EXPIRES_IN=

CLIENT_ORIGIN=
STAFF_DOMAIN=

PORT=
NODE_ENV=

# Opportunity matching (utils/geminiMatcher.js) — get a key at
# https://aistudio.google.com/apikey. Without this set, recommended
# opportunities still work via a plain keyword-overlap fallback, just less
# accurately than real Gemini matching.
GEMINI_API_KEY=
GEMINI_MODEL=

# File storage for task submissions and Track A proof-of-work photos
# (utils/driveUpload.js) — uploaded straight into one folder inside
# amit@sankalptaru.org's own Google Drive (not a service account — a plain
# "signed in as this one person" OAuth setup; a service account was tried
# first but needs a Shared Drive, which this account's plan doesn't have).
# Until these are set, any file upload attempt fails with a clear "storage
# not configured" message rather than a confusing SDK error — pasted
# Google Drive/Docs links still work fine either way, since those are just
# stored as text.
#
# One-time setup:
#   1. In Google Cloud Console (console.cloud.google.com), enable the
#      "Google Drive API" for a project, then create an OAuth 2.0 Client ID
#      of type "Desktop app" (APIs & Services -> Credentials). That gives
#      you GOOGLE_DRIVE_CLIENT_ID and GOOGLE_DRIVE_CLIENT_SECRET.
#   2. Put those two values in below, then run (signed in as
#      amit@sankalptaru.org when the consent screen opens):
#        npm run drive:auth
#      It prints a GOOGLE_DRIVE_REFRESH_TOKEN line — paste it in below too.
#   3. In Google Drive, open (or create) the folder you want uploads to
#      land in and copy its ID from the URL:
#      https://drive.google.com/drive/folders/<THIS_PART_IS_THE_ID>
#
# GOOGLE_DRIVE_CLIENT_ID / GOOGLE_DRIVE_CLIENT_SECRET: the OAuth client from step 1
# GOOGLE_DRIVE_REFRESH_TOKEN: printed by `npm run drive:auth` in step 2
# GOOGLE_DRIVE_FOLDER_ID: the destination folder's ID from step 3
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Volunteer notification emails (utils/mailer.js) via Amazon SES — sent on:
# Track B "Shortlisted", "Task Assigned", "Revision Needed", and "Completed"
# (with the certificate PDF attached), plus Track A's auto-approval
# (also with the certificate PDF attached). Until all four of these are
# set, emails are skipped with a clear one-line console warning — nothing
# else in the app is affected (see mailer.js's header comment).
#
# One-time setup (console.aws.amazon.com):
#   1. Create (or reuse) an IAM user with permission to call SES's
#      SendRawEmail action, and generate an access key for it
#      (IAM -> Users -> Security credentials -> Create access key).
#      That gives you AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY.
#   2. In Simple Email Service (SES), pick the region you'll send from and
#      verify a sender identity there (an email address or a whole domain) —
#      SES -> Verified identities -> Create identity. That's SES_FROM_EMAIL
#      (must exactly match a verified address, or any address on a verified
#      domain) and AWS_REGION (e.g. ap-south-1, us-east-1 — must be the same
#      region the identity was verified in).
#   3. New AWS accounts start in the SES "sandbox": you can only send TO
#      addresses that are also verified, and there's a low daily sending
#      limit. For real volunteers to receive these emails, request
#      production access from SES -> Account dashboard (usually approved
#      within a day for a clear use case like this one) — no code change
#      needed once that's approved.
#
# AWS_REGION: the SES region you verified your identity in
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY: the IAM access key from step 1
# SES_FROM_EMAIL: the verified sender address from step 2
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=
